<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>ProtoBuf.AotGrpcMetadataDiff</RootNamespace>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- [ProtoGrpc]/[ProtoService] and friends are [Experimental] until this work settles -->
    <NoWarn>$(NoWarn);PBN9001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- the reflective side of the differential: the real binder, at the version we pin -->
    <PackageReference Include="protobuf-net.Grpc" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" VersionOverride="4.8.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- [Authorize], so the fixture exercises the attribute the whole feature exists for -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\protobuf-net\protobuf-net.csproj" />
    <!-- Aliases is load-bearing, not tidiness: BuildTools *compiles in* protobuf-net.Core's sources,
         and protobuf-net.Grpc brings the real Core, so an unaliased reference would make every type in
         Core ambiguous. Behind an alias the two copies never meet, and `global::` still names the real
         one. AotDifferential solves the same problem by loading BuildTools reflectively; we cannot,
         because we call MetadataGather and AttributeRenderer directly rather than driving a generator
         through Roslyn's interfaces. -->
    <ProjectReference Include="..\protobuf-net.BuildTools\protobuf-net.BuildTools.csproj"
                      Aliases="buildtools" />
  </ItemGroup>

  <ItemGroup>
    <!-- compiled by the SDK for the reflective side, and copied out so Roslyn can compile the same
         source again at run time for the symbol side -->
    <Content Include="Fixtures\**\*.cs" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
