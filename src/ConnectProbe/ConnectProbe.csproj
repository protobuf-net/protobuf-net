<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>ProtoBuf.ConnectProbe</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- the compile-time model attributes are [Experimental] while the shape settles -->
    <NoWarn>$(NoWarn);PBN9001</NoWarn>
    <!-- proves the client survives native AOT; also enables trim/AOT analysis at ordinary build
         time, which is how an annotation regression is caught without a native publish -->
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <SuppressTrimAnalysisWarnings>false</SuppressTrimAnalysisWarnings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../protobuf-net.Connect/protobuf-net.Connect.csproj" />
    <!-- note: NOT protobuf-net. Only protobuf-net.Core arrives (transitively), so RuntimeTypeModel is
         not even on the reference graph and there is no reflective path to fall into by accident. -->
    <ProjectReference Include="../protobuf-net.BuildTools/protobuf-net.BuildTools.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
