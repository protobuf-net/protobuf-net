<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>ProtoBuf.ConnectJsonDifferential</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- PBN9001 is [ProtoModel]'s [Experimental] gate; protoc's DTOs carry their own style -->
    <NoWarn>$(NoWarn);PBN9001;CS8981;CS1591</NoWarn>
    <!-- the generated JSON surface is the thing under review here, so keep it on disk -->
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>generated</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- EmitCompilerGeneratedFiles writes INTO the project directory, so the default globs pick the
         output back up and every generated member is then declared twice. Excluding is the fix; the
         files are a reviewing aid, not sources. -->
    <Compile Remove="generated/**" />
  </ItemGroup>

  <ItemGroup>
    <!-- the schema is re-derived and compared on every run; it must sit beside the binary -->
    <None Include="proto/oracle.proto" Link="oracle.proto" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- the oracle: protoc's own C# for the same schema, so the comparison is against Google's
         JsonFormatter rather than against our opinion of the mapping -->
    <Protobuf Include="proto/oracle.proto" ProtoRoot="proto" GrpcServices="None" />
    <PackageReference Include="Grpc.Tools" PrivateAssets="all" />
    <PackageReference Include="Google.Protobuf" />

    <!-- protobuf-net (not just Core): GetProto needs RuntimeTypeModel, and the schema it emits is
         what the .proto beside this is checked against -->
    <ProjectReference Include="../protobuf-net/protobuf-net.csproj" />
    <ProjectReference Include="../protobuf-net.Connect/protobuf-net.Connect.csproj" />
    <ProjectReference Include="../protobuf-net.BuildTools/protobuf-net.BuildTools.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
