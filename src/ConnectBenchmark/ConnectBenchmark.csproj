<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- net8.0 only: protobuf-net.Connect is, and src/Benchmark multi-targets down to net472 -
         which is why this is a sibling project rather than more files in that one -->
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>ProtoBuf.ConnectBenchmark</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);PBN9001;CS1591</NoWarn>
    <!-- BenchmarkDotNet wants release-quality codegen; a Debug run warns and is worthless -->
    <Optimize Condition="'$(Configuration)'=='Release'">true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <None Include="proto/payload.proto" Link="payload.proto" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
    <!-- the contract-first comparison: protoc's own C# and Google's JsonFormatter -->
    <Protobuf Include="proto/payload.proto" ProtoRoot="proto" GrpcServices="None" />
    <PackageReference Include="Grpc.Tools" PrivateAssets="all" />
    <PackageReference Include="Google.Protobuf" />

    <ProjectReference Include="../protobuf-net/protobuf-net.csproj" />
    <ProjectReference Include="../protobuf-net.Connect/protobuf-net.Connect.csproj" />
    <ProjectReference Include="../protobuf-net.Connect.Google/protobuf-net.Connect.Google.csproj" />
    <ProjectReference Include="../protobuf-net.BuildTools/protobuf-net.BuildTools.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
