<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net10.0;net472</TargetFrameworks>
    <RootNamespace>ProtoBuf.Nano.Bench</RootNamespace>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- nano-core micro-benchmarks: see docs/nano-core.md - "functionally correct" is step 0 -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
    <!-- descriptor.proto composite: Google.Protobuf is the home-turf competitor row, and
         protobuf-net + Reflection self-generate the payload (descriptor.proto's own descriptor) -->
    <!-- aliased: protobuf-net.Reflection's DTOs share the Google.Protobuf.Reflection namespace,
         so the package must be reached via gpb:: (the extern-alias situation AGENTS.md documents) -->
    <PackageReference Include="Google.Protobuf" Aliases="gpb" />
    <ProjectReference Include="..\NanoState\NanoState.csproj" />
    <ProjectReference Include="..\protobuf-net.Core\protobuf-net.Core.csproj" />
    <ProjectReference Include="..\protobuf-net\protobuf-net.csproj" />
    <ProjectReference Include="..\protobuf-net.Reflection\protobuf-net.Reflection.csproj" />
  </ItemGroup>

</Project>
