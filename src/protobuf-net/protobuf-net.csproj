<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>protobuf-net</AssemblyName>
    <Title>protobuf-net</Title>
    <Description>Provides simple access to fast and efficient "Protocol Buffers" serialization from .NET applications</Description>
    <TargetFrameworks>net462;netstandard2.0;netstandard2.1;net8.0</TargetFrameworks>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Configurations>Debug;Release</Configurations>
  </PropertyGroup>

  <!-- define configuration per-platform -->
  <PropertyGroup Condition="'$(TargetFramework)' != 'net462'">
    <DefineConstants>$(DefineConstants);PLAT_NO_EMITDLL</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Reflection.Emit" />
    <PackageReference Include="System.Reflection.Emit.Lightweight" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\protobuf-net.Core\protobuf-net.Core.csproj" />
  </ItemGroup>

  <!-- Ship the build-time tooling with the library rather than as an opt-in package: the analyzers
       and the AOT generator are only useful if they are present, and a feature nobody can find is a
       feature nobody uses. Declining is one property - see ProtoBufDisableBuildTools - which is what
       makes shipping it by default reasonable.

       ReferenceOutputAssembly="false": we need it *built* (for the pack below), but protobuf-net must
       not reference an analyzer assembly that compiles in Core's own sources. No cycle either way -
       BuildTools includes Core's sources rather than referencing the project. -->
  <ItemGroup>
    <ProjectReference Include="..\protobuf-net.BuildTools\protobuf-net.BuildTools.csproj"
                      ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\protobuf-net.BuildTools\bin\$(Configuration)\netstandard2.0\protobuf-net.BuildTools.dll"
          Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <!-- renamed on the way in: a package's build props is auto-imported only when it is named after
         the package, so protobuf-net.BuildTools.props has to arrive here as protobuf-net.props -->
    <None Include="..\protobuf-net.BuildTools\protobuf-net.BuildTools.props"
          Pack="true" PackagePath="build/protobuf-net.props" Visible="false" />
  </ItemGroup>

  <ItemGroup>
	  <None Include="Meta\MetaType.Nullability.cs">
		  <DependentUpon>Meta\MetaType.cs</DependentUpon>
	  </None>
  </ItemGroup>
  <ItemGroup Label="public API tracking">
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <!-- APIs for all target frameworks -->
    <AdditionalFiles Include="PublicAPI/PublicAPI.*.txt" />
    <!-- progressively additive APIs in later frameworks; each folder is effectively NET_X_Y_OR_GREATER -->
    <AdditionalFiles Include="PublicAPI/netstandard2.1/PublicAPI.*.txt" Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'netstandard2.1'))" />
    <!-- the one non-additive split: ReadIntPtr/WriteIntPtr spell as System.IntPtr down-level but nint on net8.0+ -->
    <AdditionalFiles Include="PublicAPI/pre-net8.0/PublicAPI.*.txt" Condition="!$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))" />
    <AdditionalFiles Include="PublicAPI/net8.0/PublicAPI.*.txt" Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))" />
    <!-- net4x-only surface (e.g. persist-to-dll) -->
    <AdditionalFiles Include="PublicAPI/net462/PublicAPI.*.txt" Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net462'))" />
  </ItemGroup>
</Project>
