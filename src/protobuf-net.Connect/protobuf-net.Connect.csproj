<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net8.0 only, deliberately: this is new surface with no down-level burden, and the AOT
         generator's floor (C# 12, [UnsafeAccessor]) is net8.0 anyway. Revisit if a netstandard2.0
         consumer ever asks; nothing here needs anything newer. -->
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>ProtoBuf.Connect</RootNamespace>
    <AssemblyName>protobuf-net.Connect</AssemblyName>
    <Nullable>enable</Nullable>
    <Description>Connect protocol (connectrpc.com) client for protobuf-net - experimental</Description>
    <!-- experimental; not on the Packing list in Build.csproj and has no ApiCompat baseline -->
    <IsPackable>false</IsPackable>
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>

  <ItemGroup>
    <!-- protobuf-net.Core, NOT protobuf-net: RuntimeTypeModel is deliberately not referenced, so
         there is no reflective path to fall back to even by accident. The model is a generated
         TypeModel; see src/ConnectProbe. -->
    <ProjectReference Include="../protobuf-net.Core/protobuf-net.Core.csproj" />
  </ItemGroup>

</Project>
