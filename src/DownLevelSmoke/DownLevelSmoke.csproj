<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- the whole point: a consumer with no [UnsafeAccessor], i.e. anything below net8.0. There is
         still plenty of .NET Framework out there, and it should get a smaller model rather than a
         broken build -->
    <TargetFramework>net472</TargetFramework>
    <!-- net4x defaults to C# 7.3, and the generator has a hard C# 12 floor (PBN2000) -->
    <LangVersion>12.0</LangVersion>
    <RootNamespace>ProtoBuf.DownLevelSmoke</RootNamespace>
    <AssemblyName>DownLevelSmoke</AssemblyName>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <IsPackable>false</IsPackable>
    <Description>Dev tool: proves a generated model still builds and runs where [UnsafeAccessor] is unavailable</Description>
    <!-- the compile-time model attributes are [Experimental] while the shape settles -->
    <NoWarn>$(NoWarn);PBN9001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../protobuf-net/protobuf-net.csproj" />
    <ProjectReference Include="../protobuf-net.BuildTools/protobuf-net.BuildTools.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
