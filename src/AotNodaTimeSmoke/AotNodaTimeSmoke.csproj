<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- the compile-time model attributes are [Experimental] while the shape settles -->
    <NoWarn>$(NoWarn);PBN9001</NoWarn>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <LangVersion>12</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NodaTime" />
  </ItemGroup>

  <ItemGroup>
    <!-- the consumer references *only* the helper package and NodaTime itself; it says nothing
         about surrogates, and gets them from the helper's assembly-level declarations -->
    <ProjectReference Include="..\protobuf-net.NodaTime\protobuf-net.NodaTime.csproj" />
    <ProjectReference Include="..\protobuf-net.BuildTools\protobuf-net.BuildTools.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
