<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>ProtoBuf.ConnectConformance</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- the generated conformance DTOs are protoc's, and carry their own style -->
    <NoWarn>$(NoWarn);CS8981</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- The conformance suite's own contracts, vendored at the runner's version (v1.0.5) so the two
         cannot drift silently. Only the three the server needs are compiled: client_compat and
         suite describe the CLIENT-mode protocol and the test-suite format, neither of which a
         server-under-test parses.
         Server="true" on service.proto only - server_compat/config are plain messages. -->
    <Protobuf Include="proto/connectrpc/conformance/v1/config.proto" ProtoRoot="proto" GrpcServices="None" />
    <Protobuf Include="proto/connectrpc/conformance/v1/server_compat.proto" ProtoRoot="proto" GrpcServices="None" />
    <Protobuf Include="proto/connectrpc/conformance/v1/service.proto" ProtoRoot="proto" GrpcServices="Server" />

    <PackageReference Include="Grpc.Tools" PrivateAssets="all" />
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.StatusProto" />
    <ProjectReference Include="../protobuf-net.Connect.AspNetCore/protobuf-net.Connect.AspNetCore.csproj" />
  </ItemGroup>

</Project>
