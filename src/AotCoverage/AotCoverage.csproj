<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- a reviewing aid, not a test: never fail a build over its own analysis -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" VersionOverride="4.8.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\protobuf-net.BuildTools\protobuf-net.BuildTools.csproj" />
  </ItemGroup>

</Project>
